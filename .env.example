# =========================================================================
# ASSIGNMENT CONFIGURATION TEMPLATE
# Instructions for Instructor: 
# Please copy this file, rename it to ".env", and fill in your local credentials.
# =========================================================================

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_username_here
DB_PASSWORD=your_database_password_here

# Application Configuration
APP_ENV=development
APP_PORT=3000

# Security / API Keys (If any)
API_SECRET_KEY=your_api_key_here
